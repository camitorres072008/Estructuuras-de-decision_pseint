Algoritmo sistema_operativo
	Definir  op Como Caracter
	
	Escribir " Ingrese un caracter:"
	leer op
	Escribir " su opcion es "
	si ( op == 'a' o op == 'A') Entonces
		Imprimir " Android"
	SiNo
		si ( op == 'i' o op =='I') Entonces
			imprimir " iOS"
		SiNo
			Escribir "invalida"
		
		FinSi
	FinSi
	
FinAlgoritmo
