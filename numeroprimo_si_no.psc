Algoritmo numeroprimo_si_no
	definir x Como Entero
	definir z  como cadena
	Escribir " Ingrese un numero entre el 0 y el 20"
	leer x
	si (x =2 o x =3 o x =5 o x=7 o x=11 o x =13 o x=17 o x = 19  )
		z = " este es un numero primo "
	SiNo
		z= " este no es un numero primo"
		
	FinSi
	Escribir z

FinAlgoritmo
