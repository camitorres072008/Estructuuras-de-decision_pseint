Algoritmo mayor_numero
	Definir n1,n2, mayorr Como Entero
	Escribir " ingrese el primer numero"
	Leer n1
	Escribir " ingrese el segundo numero "
	Leer n2
	si n1 > n2 Entonces
		mayorr = n1 
	SiNo
		mayorr = n2
		Escribir "El mayor entre" n1 "y" n2 
		Escribir " es" mayorr 
	FinSi
	
	
FinAlgoritmo
